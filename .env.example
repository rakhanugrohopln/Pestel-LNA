# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional AI model override (e.g. gemini-4-hydrogen, gemini-2.5-flash)
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Hosted URL injected by AI Studio / Cloud Run
APP_URL="MY_APP_URL"

# Environment mode: staging | production
APP_ENV="staging"

# Strong random HMAC secret for session cookie signing (min 32 chars in production / Cloud Run)
SESSION_SECRET="CHANGE_ME_TO_STRONG_RANDOM_SECRET"

# Server secret (min 12 chars) enabling authorized Super Admin password recovery on /login
ADMIN_RECOVERY_KEY=""

# Optional one-time idempotent Super Admin reset/provisioning via server Secrets (never hardcoded)
ADMIN_RESET_EMAIL="admin.corpu@pln.co.id"
ADMIN_RESET_PASSWORD=""

# Optional explicit Super Admin bootstrap credentials (used only once when no Super Admin exists)
BOOTSTRAP_ADMIN_EMAIL="admin.corpu@pln.co.id"
BOOTSTRAP_ADMIN_PASSWORD=""

# UAT / QC quick-login (strictly disabled automatically when NODE_ENV=production or APP_ENV=production)
ENABLE_UAT_QUICK_LOGIN="true"
UAT_QC_PASSCODE=""
